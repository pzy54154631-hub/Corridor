# Corridor talks to a synthetic bank only; nothing here can move real money.
# Copy this file to .env and add a key only if you want the live model path.
# Scripted demos, tests and strict replay never read it. Never commit .env.
LLM_API_KEY=

# Default: an OpenAI-compatible endpoint. The base URL is pinned; redirects are refused.
LLM_PROVIDER=openai
LLM_API_BASE=https://api.openai.com/v1
# Model tiers. gpt-6 function calls need the Responses API.
LLM_MODEL=gpt-6.1-sol
LLM_MODEL_CHEAP=gpt-6-luna
LLM_MODEL_WEAK=gpt-5.4-mini
LLM_API=responses
LLM_REASONING_EFFORT=low

# Hard limits per client. Live and record modes refuse to start unless both are positive.
LLM_MAX_USD=15
LLM_MAX_CALLS=3000
# Conservative price assumptions in USD per million tokens, used only by the budget guard.
# They are not any provider's official pricing.
LLM_ASSUMED_PRICE_IN=10
LLM_ASSUMED_PRICE_OUT=40

# Domestic providers: change provider, base URL, model and API style together,
# and leave LLM_REASONING_EFFORT empty for chat-style APIs.
#   DeepSeek:  LLM_PROVIDER=deepseek  LLM_API_BASE=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat  LLM_API=chat
#   DashScope: LLM_PROVIDER=dashscope LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus  LLM_API=chat

# The interface language is read from the process environment, not from this file:
#   PowerShell:  $env:CORRIDOR_LOCALE = 'zh-CN'   (or 'en')

# Domestic UI live switch (product layer; off by default). The seven names below are
# PROCESS ENVIRONMENT variables, set in the shell that starts the demo: the UI never
# reads them from this file or from .env (only LIVE_ACCESS_CODE may also sit in a
# credential file). They are commented out on purpose; a blank value means "not set".
# Live access needs all of: the switch, a credential directory holding the deployment's
# file (.env / .env.deepseek / .env.zhipu) read by path, the access code, and a journal
# directory. Do not export the LLM_* names above into that shell: live access refuses
# to start while the frozen client could inherit them.
# PowerShell: $env:CORRIDOR_LIVE='1'; $env:CORRIDOR_LIVE_ENV_DIR='<credential dir>';
#             $env:LIVE_JOURNAL_DIR='<journal dir>'; uv run --frozen corridor demo
# CORRIDOR_LIVE=1
# CORRIDOR_LIVE_ENV_DIR=<directory holding .env / .env.deepseek / .env.zhipu>
# LIVE_ACCESS_CODE=<judges' access code>
# Two caps: calls per browser session (default 40), and spend per journal directory and
# currency, cumulative with no daily reset (defaults 5 USD / 30 CNY, assumed prices).
# LIVE_SESSION_CALLS=40
# LIVE_BUDGET_USD=5
# LIVE_BUDGET_CNY=30
# Required: record-mode journal of every live call (strict offline replay), its manifest,
# outcome index and the spend ledger; a new directory starts a new spend total.
# LIVE_JOURNAL_DIR=<journal dir>
