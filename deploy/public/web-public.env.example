# Corridor 公开模式环境文件模板。install.sh 首次安装时复制到 /etc/corridor/web-public.env，
# 权限 0600、属主 root，之后不再覆盖。服务由 systemd 读取，不要用 shell source 这个文件。
# 这个模板是脚本规划配置：不含任何秘密，不需要模型密钥就能启动。
# 打开真模型由 enable_live.sh 完成：它写入 CORRIDOR_LIVE=1 和 access_setup 打印的两行。
CORRIDOR_WEB_PUBLIC_HOST=43-154-247-126.sslip.io
CORRIDOR_WEB_PUBLIC_DEPLOYMENTS=deepseek-flash
CORRIDOR_LIVE=0
CORRIDOR_LIVE_ENV_DIR=/etc/corridor/live
LIVE_JOURNAL_DIR=/var/lib/corridor/journal
LIVE_SESSION_CALLS=20
LIVE_BUDGET_CNY=100
CORRIDOR_LOCALE=zh-CN
CORRIDOR_DEFAULT_VIEW=customer
